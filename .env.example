OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Stagehand-backed WebKobeGraph smoke.
# Python SDK path: prefer MODEL_API_KEY for BYO model keys.
STAGEHAND_SERVER=local
STAGEHAND_MODEL=deepseek/your-model-name
MODEL_API_KEY=your-model-api-key-here
# Optional: increase if the local Stagehand SEA server is slow to become ready.
# STAGEHAND_LOCAL_READY_TIMEOUT_S=45

# Optional Stagehand service endpoint. This is not the LLM provider base URL.
# STAGEHAND_API_URL=https://api.stagehand.browserbase.com

# Optional provider-specific alias supported by this project for deepseek/... models.
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional Qwen / Alibaba Cloud DashScope configuration.
# Use underscores rather than hyphens so the names are valid environment variables.
QWEN_API_KEY=your-qwen-or-dashscope-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_STATE_EMBEDDING_MODEL=text-embedding-v4
QWEN_STATE_EMBEDDING_DIMENSION=1024
