# Supply your own API key. No credentials are distributed with this release.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISUAL_DELTA_MODEL=gpt-4o
OPENAI_ACTION_OUTCOME_MODEL=gpt-4o
OPENAI_RISK_DETECTION_MODEL=gpt-4o

# Run the Stagehand service locally, using the same OpenAI key.
STAGEHAND_SERVER=local
STAGEHAND_MODEL=openai/gpt-4o

# Optional overrides for an OpenAI-compatible provider.
# MODEL_API_KEY=
# STAGEHAND_MODEL_BASE_URL=
# STAGEHAND_LOCAL_READY_TIMEOUT_S=45
