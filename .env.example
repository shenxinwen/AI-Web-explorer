OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# Screenshot VLM used for business-affordance proposals, state labels, and
# before/after Visual Delta. This is separate from STAGEHAND_MODEL.
OPENAI_VISUAL_DELTA_MODEL=gpt-4o

# Stagehand-backed WebKobeGraph smoke.
# Python SDK path: prefer MODEL_API_KEY for BYO model keys.
STAGEHAND_SERVER=local
STAGEHAND_MODEL=deepseek/your-model-name
MODEL_API_KEY=your-model-api-key-here
# Optional: increase if the local Stagehand SEA server is slow to become ready.
# STAGEHAND_LOCAL_READY_TIMEOUT_S=45

# Optional Stagehand service endpoint. This is not the LLM provider base URL.
# STAGEHAND_API_URL=https://api.stagehand.browserbase.com

# Optional provider-specific alias supported by this project for deepseek/... models.
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional OpenAI-compatible state embedding configuration.
# For Qwen / Alibaba Cloud DashScope, use the compatible-mode endpoint below.
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
